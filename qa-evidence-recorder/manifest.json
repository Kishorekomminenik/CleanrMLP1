{
  "manifest_version": 3,
  "name": "QA Evidence Recorder",
  "version": "1.0.0",
  "description": "Record tab video, screenshots, and network logs for QA evidence.",
  "action": {
    "default_title": "QA Evidence Recorder",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "storage",
    "tabCapture",
    "debugger"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
