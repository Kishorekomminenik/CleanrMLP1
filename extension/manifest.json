{
  "manifest_version": 3,
  "name": "QA Evidence Recorder",
  "version": "0.1.0",
  "description": "Capture screenshots, tab recordings, and network/console logs for QA evidence bundles.",
  "action": {
    "default_title": "QA Evidence Recorder",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "tabs",
    "storage",
    "downloads",
    "clipboardWrite",
    "tabCapture",
    "offscreen"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content_script.js"
      ],
      "run_at": "document_start"
    }
  ]
}
